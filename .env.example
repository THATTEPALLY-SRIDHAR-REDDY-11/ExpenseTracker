# Copy this file and rename:
#   .env.vercel.example  →  .env.vercel   (for Vercel import)
#   .env.local.example   →  server/.env    (for local development)
#
# Do not commit files with real keys (.env, .env.vercel, server/.env).

# ---------- Vercel (production) ----------
# Import .env.vercel in: Vercel → Project → Settings → Environment Variables → Import .env
# Apply to: Production, Preview, Development (check all three)

MONGODB_URI=your_mongodb_uri_here
GROQ_API_KEY=your_groq_api_key_here

# ---------- Local server (server/.env) ----------
# MONGODB_URI=mongodb://127.0.0.1:27017/budget-tracker
# GROQ_API_KEY=your_groq_api_key_here
# PORT=5000

# ---------- Local client (optional — only if API is not on /api proxy) ----------
# VITE_API_URL=http://localhost:5000
